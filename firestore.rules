rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email == 'saiftkd3@gmail.com' && 
             request.auth.token.email_verified == true; 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /test/connection {
      allow read: if true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'preferred_language', 'current_location', 'customSOSMessage'])
      );
    }

    match /sos_requests/{sosId} {
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow read: if isSignedIn() && existing().user_id == request.auth.uid;
    }

    match /emergency_contacts/{contactId} {
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow read: if isSignedIn() && existing().user_id == request.auth.uid;
      allow update: if isSignedIn() && existing().user_id == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'relation', 'type'])
      );
      allow delete: if isSignedIn() && existing().user_id == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /service_providers/{providerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow read: if isSignedIn() && existing().user_id == request.auth.uid;
      allow delete: if isSignedIn() && existing().user_id == request.auth.uid;
    }
  }
}
